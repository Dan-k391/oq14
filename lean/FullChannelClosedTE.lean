import FullChannelPowerFinal

/-! The full physical scattering map is exactly power-isometric on the
closed Hilbert sector generated by all finite restricted-TE inputs. -/
noncomputable section
set_option autoImplicit false
set_option maxHeartbeats 4000000
namespace OQ14.FullChannelClosedTE
open FullChannelFreeMap FullChannelContinuous

/-- Physical incoming Hilbert sector selected by all finite restricted-TE waves. -/
def inputSector : Submodule ℂ transverse := LinearMap.range teInput |>.topologicalClosure

def restrictedScattering (c : StaticCoefficient.Coefficient) (d : BoundedMaterialKernel.SupportData c) :
    inputSector →L[ℂ] ComplexVectorSphere.Ambient := (scatteringCLM c d).comp inputSector.subtypeL

theorem finite_mem (A : SymmetricHarmonicJets.Index →₀ ℂ) : teInput A ∈ inputSector := by
  apply Submodule.le_topologicalClosure
  exact ⟨A,rfl⟩

theorem sector_isometric (c : StaticCoefficient.Coefficient) (d : BoundedMaterialKernel.SupportData c)
    (hpower : ∀ A : SymmetricHarmonicJets.Index →₀ ℂ,
      ‖scatteringCLM c d (teInput A)‖^2 = RestrictedTEIncoming.physicalPower A) :
    ∀ F : inputSector, ‖restrictedScattering c d F‖ = ‖F‖ := by
  have hfinite (A : SymmetricHarmonicJets.Index →₀ ℂ) :
      ‖scatteringCLM c d (teInput A)‖ = ‖teInput A‖ := by
    have hh := (hpower A).trans (RestrictedTEInput.input_norm_sq A).symm
    have h1 := norm_nonneg (scatteringCLM c d (teInput A))
    have h2 := norm_nonneg (teInput A)
    change ‖scatteringCLM c d (teInput A)‖^2 = ‖teInput A‖^2 at hh
    nlinarith
  have hclosed : IsClosed {F : transverse | ‖scatteringCLM c d F‖ = ‖F‖} :=
    isClosed_eq ((scatteringCLM c d).continuous.norm) continuous_norm
  have hsub : (LinearMap.range teInput : Set transverse) ⊆
      {F : transverse | ‖scatteringCLM c d F‖ = ‖F‖} := by
    rintro F ⟨A,rfl⟩
    exact hfinite A
  intro F
  have hmem : (F : transverse) ∈ closure (LinearMap.range teInput : Set transverse) := F.property
  have hh := closure_minimal hsub hclosed hmem
  exact hh

theorem sector_contractive (c : StaticCoefficient.Coefficient) (d : BoundedMaterialKernel.SupportData c)
    (hpower : ∀ A : SymmetricHarmonicJets.Index →₀ ℂ,
      ‖scatteringCLM c d (teInput A)‖^2 = RestrictedTEIncoming.physicalPower A) :
    ∀ F : inputSector, ‖restrictedScattering c d F‖ ≤ ‖F‖ := by
  intro F
  exact (sector_isometric c d hpower F).le
end OQ14.FullChannelClosedTE
#print axioms OQ14.FullChannelClosedTE.finite_mem
#print axioms OQ14.FullChannelClosedTE.sector_isometric
#print axioms OQ14.FullChannelClosedTE.sector_contractive
