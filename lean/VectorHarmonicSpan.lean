import HarmonicVectorConstants
import HarmonicPolynomialRestriction
import VectorHarmonicNormalization

/-! Actual continuous sphere vector fields generated by scalar harmonic sectors. -/
noncomputable section
set_option autoImplicit false
set_option maxHeartbeats 3000000
namespace OQ14.VectorHarmonicSpan
open MvPolynomial OQ14.HarmonicPolynomial OQ14.PolynomialVectorCalculus
open OQ14.SphereHarmonicBasis

def vectorMap : Vec →ₗ[ℝ] C(Sphere,OQ14.Maxwell.Space) where
  toFun := VectorHarmonicNormalization.restriction
  map_add' Q V := by
    ext n i
    simp [VectorHarmonicNormalization.restriction,map_add]
  map_smul' a Q := by
    ext n i
    simp [VectorHarmonicNormalization.restriction,map_smul]

theorem vectorMap_apply (Q : Vec) (n : Sphere) (i : Fin 3) :
    vectorMap Q n i=SpherePolynomial.polynomialMap (Q i) n := rfl

theorem radiusSq_mul (Q : Vec) : vectorMap (fun i => radiusSq*Q i)=vectorMap Q := by
  ext n i
  simp only [vectorMap_apply,map_mul,ContinuousMap.mul_apply,FischerDecomposition.radiusSq_on_sphere,
    ContinuousMap.one_apply,one_mul]

def generators : Set C(Sphere,OQ14.Maxwell.Space) :=
  {v | ∃ (l : ℕ) (p : Poly),p.IsHomogeneous l ∧ formalLaplacian p=0 ∧
    (v=vectorMap (grad p) ∨ v=vectorMap (radial p) ∨ v=vectorMap (tor (grad p)))}

def sectorSpan : Submodule ℝ C(Sphere,OQ14.Maxwell.Space) := Submodule.span ℝ generators

theorem grad_mem (p : Poly) (l : ℕ) (hp : p.IsHomogeneous l) (hh : formalLaplacian p=0) :
    vectorMap (grad p)∈sectorSpan := Submodule.subset_span ⟨l,p,hp,hh,Or.inl rfl⟩

theorem radial_mem (p : Poly) (l : ℕ) (hp : p.IsHomogeneous l) (hh : formalLaplacian p=0) :
    vectorMap (radial p)∈sectorSpan := Submodule.subset_span ⟨l,p,hp,hh,Or.inr (Or.inl rfl)⟩

theorem tor_mem (p : Poly) (l : ℕ) (hp : p.IsHomogeneous l) (hh : formalLaplacian p=0) :
    vectorMap (tor (grad p))∈sectorSpan := Submodule.subset_span ⟨l,p,hp,hh,Or.inr (Or.inr rfl)⟩

theorem positive_degree_mem (Q : Vec) (n : ℕ) (hp : ∀ i,(Q i).IsHomogeneous (n+1))
    (hh : ∀ i,formalLaplacian (Q i)=0) : vectorMap Q∈sectorSpan := by
  let A : ℝ := ((n : ℝ)+1)*((n : ℝ)+2)*(2*(n : ℝ)+3)
  have hA : A≠0 := by dsimp [A]; positivity
  apply (Submodule.smul_mem_iff sectorSpan hA).mp
  have hg := grad_mem _ (n+2) (HarmonicVectorDecomposition.upper_homogeneous Q n hp)
    (HarmonicVectorDecomposition.upper_harmonic Q n hp hh)
  have ht := tor_mem _ (n+1) (HarmonicVectorDecomposition.middle_homogeneous Q n hp)
    (HarmonicVectorDecomposition.middle_harmonic Q hh)
  have hd := HarmonicVectorDecomposition.div_homogeneous Q n hp
  have hl := HarmonicVectorDecomposition.div_harmonic Q hh
  have h := sectorSpan.add_mem
    (sectorSpan.add_mem (sectorSpan.smul_mem ((n : ℝ)+1) hg) (sectorSpan.smul_mem (2*(n : ℝ)+3) ht))
    (sectorSpan.smul_mem ((n : ℝ)+2) (sectorSpan.sub_mem
      (sectorSpan.smul_mem (2*(n : ℝ)+1) (radial_mem _ n hd hl)) (grad_mem _ n hd hl)))
  convert h using 1
  rw [← radiusSq_mul (grad (div Q))]
  simp only [← map_smul,← map_add,← map_sub]
  congr 1
  funext i
  simpa only [Pi.add_apply,Pi.sub_apply,Pi.smul_apply,smul_eq_C_mul,radial,A,mul_assoc]
    using HarmonicVectorDecomposition.decomposition_scaled Q n hp hh i

theorem harmonic_vector_mem (Q : Vec) (l : ℕ) (hp : ∀ i,(Q i).IsHomogeneous l)
    (hh : ∀ i,formalLaplacian (Q i)=0) : vectorMap Q∈sectorSpan := by
  cases l with
  | zero =>
    rw [← HarmonicVectorConstants.decomposition Q hp]
    exact grad_mem _ 1 (HarmonicVectorDecomposition.radialDot_homogeneous Q 0 hp)
      (HarmonicVectorConstants.radialDot_harmonic Q hp)
  | succ n => exact positive_degree_mem Q n hp hh

end OQ14.VectorHarmonicSpan

