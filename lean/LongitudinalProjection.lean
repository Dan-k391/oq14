import Mathlib.Analysis.InnerProductSpace.PiL2
import Mathlib.Analysis.InnerProductSpace.Positive
import Mathlib.MeasureTheory.Function.L2Space
import Mathlib.MeasureTheory.Measure.Lebesgue.Basic
import Mathlib.Tactic.FunProp
import Mathlib.Tactic.Ring

/-!
# The actual longitudinal frequency multiplier

At every real frequency xi the symbol is the orthogonal projection onto
the complex line generated by xi, including the zero symbol at xi = 0.
The coordinate formula is xi_i * sum_j xi_j z_j / sum_j xi_j^2.
This file constructs that multiplier on genuine vector-valued L2.

The pinned mathlib does not provide a Euclidean L2 Plancherel equivalence.
No such equivalence or physical-space Newton-kernel identification is
postulated here. Fourier conjugation remains an explicitly separate step.
-/

noncomputable section
set_option autoImplicit false
set_option maxHeartbeats 800000

namespace OQ14.LongitudinalProjection

open MeasureTheory ContinuousLinearMap
open scoped InnerProductSpace ComplexConjugate ENNReal

abbrev Frequency := Fin 3 → ℝ
abbrev Vector := EuclideanSpace ℂ (Fin 3)
abbrev FrequencyL2 := Lp Vector 2 (volume : Measure Frequency)

def complexify (ξ : Frequency) : Vector :=
  (WithLp.equiv 2 (Fin 3 → ℂ)).symm (fun i => (ξ i : ℂ))

def longitudinalLine (ξ : Frequency) : Submodule ℂ Vector :=
  ℂ ∙ complexify ξ

def symbol (ξ : Frequency) : Vector →L[ℂ] Vector :=
  (longitudinalLine ξ).subtypeL ∘L (longitudinalLine ξ).orthogonalProjection

theorem symbol_formula (ξ : Frequency) (z : Vector) :
    symbol ξ z =
      (⟪complexify ξ, z⟫_ℂ / ((‖complexify ξ‖ ^ 2 : ℝ) : ℂ)) • complexify ξ := by
  exact Submodule.orthogonalProjection_singleton ℂ z

theorem symbol_coordinate (ξ : Frequency) (z : Vector) (i : Fin 3) :
    symbol ξ z i = ((∑ j, (ξ j : ℂ) * z j) /
      (∑ j, (ξ j : ℂ) ^ 2)) * (ξ i : ℂ) := by
  rw [symbol_formula]
  have hnorm : ((‖complexify ξ‖ ^ 2 : ℝ) : ℂ) = ∑ j, (ξ j : ℂ) ^ 2 := by
    calc
      _ = ⟪complexify ξ, complexify ξ⟫_ℂ := by
        simpa using (inner_self_eq_norm_sq_to_K (𝕜 := ℂ) (complexify ξ)).symm
      _ = _ := by simp [complexify, PiLp.inner_apply, pow_two]
  rw [hnorm]
  simp [complexify, PiLp.inner_apply, mul_comm]

theorem symbol_norm_le (ξ : Frequency) (z : Vector) : ‖symbol ξ z‖ ≤ ‖z‖ := by
  change ‖(longitudinalLine ξ).orthogonalProjection z‖ ≤ ‖z‖
  calc
    _ ≤ ‖(longitudinalLine ξ).orthogonalProjection‖ * ‖z‖ :=
      (longitudinalLine ξ).orthogonalProjection.le_opNorm z
    _ ≤ 1 * ‖z‖ := mul_le_mul_of_nonneg_right
      (Submodule.orthogonalProjection_norm_le _) (norm_nonneg z)
    _ = ‖z‖ := one_mul _

theorem symbol_idempotent (ξ : Frequency) (z : Vector) :
    symbol ξ (symbol ξ z) = symbol ξ z := by
  simp [symbol]

theorem symbol_symmetric (ξ : Frequency) (z w : Vector) :
    ⟪symbol ξ z, w⟫_ℂ = ⟪z, symbol ξ w⟫_ℂ := by
  exact (longitudinalLine ξ).inner_orthogonalProjection_left_eq_right z w

theorem symbol_selfAdjoint (ξ : Frequency) : IsSelfAdjoint (symbol ξ) :=
  orthogonalProjection_isSelfAdjoint (longitudinalLine ξ)

theorem symbol_positive (ξ : Frequency) : (symbol ξ).IsPositive := by
  have h := (isPositive_one (𝕜 := ℂ) (E := longitudinalLine ξ)).conj_adjoint
    (longitudinalLine ξ).subtypeL
  simpa only [Submodule.adjoint_subtypeL, ContinuousLinearMap.one_def,
    ContinuousLinearMap.id_comp] using h

theorem symbol_zero : symbol 0 = 0 := by
  apply ContinuousLinearMap.ext
  intro z
  rw [symbol_formula]
  simp [complexify]

theorem continuous_complexify : Continuous complexify := by
  exact (PiLp.continuous_equiv_symm 2 (fun _ : Fin 3 => ℂ)).comp
    (continuous_pi fun i => Complex.continuous_ofReal.comp (continuous_apply i))

theorem aestronglyMeasurable_symbol {f : Frequency → Vector}
    (hf : AEStronglyMeasurable f (volume : Measure Frequency)) :
    AEStronglyMeasurable (fun ξ => symbol ξ (f ξ)) volume := by
  have hv : AEStronglyMeasurable complexify (volume : Measure Frequency) :=
    continuous_complexify.aestronglyMeasurable
  have hn : AEMeasurable (fun ξ => ((‖complexify ξ‖ ^ 2 : ℝ) : ℂ))
      (volume : Measure Frequency) :=
    (Complex.continuous_ofReal.comp (continuous_complexify.norm.pow 2)).aemeasurable
  have hq := (hv.inner (𝕜 := ℂ) hf).aemeasurable.div hn
  simpa only [symbol_formula] using hq.aestronglyMeasurable.smul hv

theorem memLp_symbol (f : FrequencyL2) :
    MemLp (fun ξ => symbol ξ (f ξ)) 2 (volume : Measure Frequency) := by
  apply (Lp.memLp f).of_le (aestronglyMeasurable_symbol (Lp.memLp f).1)
  exact Filter.Eventually.of_forall fun ξ => symbol_norm_le ξ (f ξ)

def applyMultiplier (f : FrequencyL2) : FrequencyL2 :=
  (memLp_symbol f).toLp (fun ξ => symbol ξ (f ξ))

theorem applyMultiplier_ae (f : FrequencyL2) :
    applyMultiplier f =ᵐ[volume] (fun ξ => symbol ξ (f ξ)) :=
  (memLp_symbol f).coeFn_toLp

theorem applyMultiplier_add (f g : FrequencyL2) :
    applyMultiplier (f + g) = applyMultiplier f + applyMultiplier g := by
  apply Lp.ext
  filter_upwards [applyMultiplier_ae (f + g), applyMultiplier_ae f,
    applyMultiplier_ae g, Lp.coeFn_add f g,
    Lp.coeFn_add (applyMultiplier f) (applyMultiplier g)] with ξ hfg hf hg ha hb
  rw [hfg, ha, hb]
  simp only [Pi.add_apply, hf, hg, map_add]

theorem applyMultiplier_smul (c : ℂ) (f : FrequencyL2) :
    applyMultiplier (c • f) = c • applyMultiplier f := by
  apply Lp.ext
  filter_upwards [applyMultiplier_ae (c • f), applyMultiplier_ae f,
    Lp.coeFn_smul c f, Lp.coeFn_smul c (applyMultiplier f)] with ξ hcf hf ha hb
  rw [hcf, ha, hb]
  simp only [Pi.smul_apply, hf, map_smul]

theorem applyMultiplier_norm_le (f : FrequencyL2) :
    ‖applyMultiplier f‖ ≤ ‖f‖ := by
  apply Lp.norm_le_norm_of_ae_le
  filter_upwards [applyMultiplier_ae f] with ξ hf
  rw [hf]
  exact symbol_norm_le ξ (f ξ)

def multiplierLinear : FrequencyL2 →ₗ[ℂ] FrequencyL2 where
  toFun := applyMultiplier
  map_add' := applyMultiplier_add
  map_smul' := applyMultiplier_smul

def multiplier : FrequencyL2 →L[ℂ] FrequencyL2 :=
  multiplierLinear.mkContinuous 1 (fun f => by
    simpa using applyMultiplier_norm_le f)

theorem multiplier_ae (f : FrequencyL2) :
    multiplier f =ᵐ[volume] (fun ξ => symbol ξ (f ξ)) :=
  applyMultiplier_ae f

theorem multiplier_norm_le : ‖multiplier‖ ≤ 1 := by
  apply ContinuousLinearMap.opNorm_le_bound _ (by norm_num)
  intro f
  simpa using applyMultiplier_norm_le f

theorem multiplier_idempotent_apply (f : FrequencyL2) :
    multiplier (multiplier f) = multiplier f := by
  apply Lp.ext
  filter_upwards [multiplier_ae (multiplier f), multiplier_ae f] with ξ hff hf
  rw [hff, hf]
  exact symbol_idempotent ξ (f ξ)

theorem multiplier_idempotent : multiplier * multiplier = multiplier := by
  apply ContinuousLinearMap.ext
  exact multiplier_idempotent_apply

theorem multiplier_symmetric (f g : FrequencyL2) :
    ⟪multiplier f, g⟫_ℂ = ⟪f, multiplier g⟫_ℂ := by
  rw [MeasureTheory.L2.inner_def, MeasureTheory.L2.inner_def]
  apply integral_congr_ae
  filter_upwards [multiplier_ae f, multiplier_ae g] with ξ hf hg
  rw [hf, hg]
  exact symbol_symmetric ξ (f ξ) (g ξ)

theorem multiplier_selfAdjoint : IsSelfAdjoint multiplier :=
  ContinuousLinearMap.isSelfAdjoint_iff_isSymmetric.mpr multiplier_symmetric

theorem multiplier_positive : multiplier.IsPositive := by
  refine ⟨multiplier_selfAdjoint, ?_⟩
  intro f
  change 0 ≤ (⟪multiplier f, f⟫_ℂ).re
  have hi := multiplier_symmetric (multiplier f) f
  rw [multiplier_idempotent_apply] at hi
  rw [hi]
  simpa only [RCLike.re_eq_complex_re] using
    (inner_self_nonneg (𝕜 := ℂ) (x := multiplier f))

end OQ14.LongitudinalProjection

